# DeepSeek（必填，AI 总结 / 导图 / 问答需要）
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# B 站登录 Cookie（可选：解锁高清晰度与部分 CC 字幕）
# 只填 SESSDATA 即可，或填完整 Cookie 字符串
BILIBILI_SESSDATA=
# BILIBILI_COOKIE=SESSDATA=...; bili_jct=...

# yt-dlp 的 Netscape cookies.txt（可选：YouTube 等需要登录的视频）
YTDLP_COOKIEFILE=

# 本地 Whisper 语音转写（无平台字幕时兜底）
ASR_ENABLED=true
ASR_MODEL=small
# medium 更准但约 1.5GB；默认 small
# ASR_MODEL_ID=Systran/faster-whisper-medium
# ASR_MODEL_DIR=backend/models/faster-whisper-small
ASR_MODEL_AUTO_DOWNLOAD=true
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_CPU_THREADS=8
ASR_LANGUAGE=auto
ASR_MAX_DURATION_MIN=60
ASR_AUTO=false

# 下载与资源限制
MAX_FILE_SIZE_MB=2048
MAX_CONCURRENT_DOWNLOADS=2
JOB_TTL_SECONDS=1800
INFO_CACHE_TTL=600

# 开发环境跨域（生产同源部署可留空）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
